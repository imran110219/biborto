# Copy to .env.local and fill in for local development.
# See docs/db/README.md for how to stand up the Postgres database itself.
DATABASE_URL=

# Required by `npm run db:seed`; used to create the initial superadmin's
# password login. Choose a strong secret; seed stores only a bcrypt hash.
SUPERADMIN_PASSWORD=

# Auth (Phase 2) — see docs/web/README.md's Auth section.
# Generate with: npx auth secret
AUTH_SECRET=

# Google OAuth — optional for local dev. Email/password sign-in works
# without these; "Continue with Google" will error until they're set.
# Get credentials from https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Cloudflare R2 gallery storage. The bucket should be publicly readable
# through a custom domain (or an r2.dev URL for local development).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Account-claim verification emails (Resend — https://resend.com).
# Without RESEND_API_KEY, non-production builds print the link to the server console.
# APP_URL is the public site origin used inside emailed links (no trailing slash).
RESEND_API_KEY=
EMAIL_FROM=
APP_URL=

# Google Analytics 4 and Search Console. Set these in the deployment environment.
# NEXT_PUBLIC_GA_ID is the GA4 measurement ID (G-XXXXXXXXXX).
NEXT_PUBLIC_GA_ID=
# GOOGLE_SITE_VERIFICATION is the token from Search Console's HTML tag method.
GOOGLE_SITE_VERIFICATION=
