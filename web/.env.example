# Copy to .env.local and fill in for local development.
# See docs/db/README.md for how to stand up the Postgres database itself.
DATABASE_URL=postgres://user:password@localhost:5432/biborto_dev

# Auth (Phase 2) — see docs/web/README.md's Auth section.
# Generate with: npx auth secret
AUTH_SECRET=

# Google OAuth — optional for local dev. Email/password sign-in works
# without these; "Continue with Google" will error until they're set.
# Get credentials from https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
