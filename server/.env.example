# Replace DOCKERHUB_USERNAME with the Docker Hub account or organization
# configured in the GitHub Actions DOCKERHUB_USERNAME secret.
IMAGE=docker.io/DOCKERHUB_USERNAME/biborto:main

# The app listens only on the server's loopback interface by default.
# Point your reverse proxy at 127.0.0.1:3000.
PORT=3000

# Required
DATABASE_URL=
AUTH_SECRET=
APP_URL=https://your-domain.example
# Optional: public origin for Auth.js callbacks, if it differs from APP_URL (usually leave blank).
AUTH_URL=

# Needed once, by ./init-db.sh (the bootstrap superadmin). 8+ characters; use double quotes if it
# contains #. SUPERADMIN_EMAIL is optional (default superadmin@biborto11.com). After the first
# successful init you can delete SUPERADMIN_PASSWORD from this file — the running app never needs it.
SUPERADMIN_PASSWORD=
SUPERADMIN_EMAIL=

# Optional Auth.js Google sign-in
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional Cloudflare R2 uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Optional email and analytics
RESEND_API_KEY=
EMAIL_FROM=
GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
