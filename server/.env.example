# Replace DOCKERHUB_USERNAME with the Docker Hub account or organization
# configured in the GitHub Actions DOCKERHUB_USERNAME secret.
IMAGE=docker.io/DOCKERHUB_USERNAME/biborto:main

# The app listens only on the server's loopback interface by default.
# Point your reverse proxy at 127.0.0.1:3000.
PORT=3000

# Required
DATABASE_URL=
AUTH_SECRET=
APP_URL=https://your-domain.example

# Optional Auth.js Google sign-in
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional Cloudflare R2 uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Optional email and analytics
RESEND_API_KEY=
EMAIL_FROM=
GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
