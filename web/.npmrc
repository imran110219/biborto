# This machine's network blocks registry.npmjs.org (a security gateway
# returns 403 Forbidden for it specifically). registry.npmmirror.com is
# the official Alibaba-maintained public mirror of the full npm registry
# and works fine here — pointing installs at it so `npm install` doesn't
# require the --registry flag every time. Safe to delete/change if you're
# on a network where the default registry works.
registry=https://registry.npmmirror.com
